# Copie este arquivo para .env e preencha os valores

# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
DATABASE_URL="postgresql://postgres:suasenha@localhost:5432/cantinapp"

# JWT - chave secreta (troque por algo aleatório em produção)
JWT_SECRET="cantinapp-super-secret-key-2025"

# Porta do servidor
PORT=3001

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:5173"
